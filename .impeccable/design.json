      "html": "<p style=\"max-width:420px;font:400 15px/1.9 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;color:#1D1D1F\">首期款为合同总额的 30%。<a class=\"ds-citation\" href=\"#\">来源#1: 采购合同-2026.pdf | 第5页</a></p>",
      "css": ".ds-citation{display:inline;padding:2px 8px;border-radius:9999px;background:rgba(88,86,214,0.10);color:var(--app-accent,#5856D6);font:500 12px/1.5 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;text-decoration:none;white-space:nowrap;transition:background 150ms cubic-bezier(.4,0,.2,1)}.ds-citation:hover{background:rgba(88,86,214,0.16);text-decoration:none}.ds-citation:focus-visible{outline:2px solid var(--app-accent,#5856D6);outline-offset:2px}@media (prefers-color-scheme: dark){.ds-citation{background:rgba(125,122,255,0.16);color:#878af5}.ds-citation:hover{background:rgba(125,122,255,0.24)}}"
    }
