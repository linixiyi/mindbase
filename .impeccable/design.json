      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-nav-item-selected\" href=\"#\">AI 问答</a><a class=\"ds-nav-item\" href=\"#\">知识库管理</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:200px;padding:8px;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Segoe UI','Microsoft YaHei',sans-serif}.ds-nav-item{display:flex;align-items:center;height:36px;padding:0 10px;border-radius:10px;color:var(--app-text-secondary,#6E6E73);font-size:14px;font-weight:500;line-height:1.4;text-decoration:none;transition:background 150ms cubic-bezier(.4,0,.2,1),color 150ms cubic-bezier(.4,0,.2,1)}.ds-nav-item:hover{background:var(--app-fill-hover,rgba(120,120,128,0.12))}.ds-nav-item:focus-visible{outline:2px solid var(--app-accent,#5856D6);outline-offset:-2px}.ds-nav-item-selected{background:var(--app-fill-subtle,rgba(120,120,128,0.08));color:var(--app-text,#1D1D1F);box-shadow:inset 2px 0 0 var(--app-accent,#5856D6)}@media (prefers-color-scheme: dark){.ds-nav-item{color:rgba(235,235,245,0.60)}.ds-nav-item:hover{background:rgba(120,120,128,0.32)}.ds-nav-item-selected{background:rgba(120,120,128,0.24);color:#F5F5F7;box-shadow:inset 2px 0 0 var(--app-accent-dark,#5B5BE8)}}"
