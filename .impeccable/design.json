    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "靛蓝填充主行动按钮；一屏内唯一的大面积强调色。按压缩放 0.97。",
      "html": "<button class=\"ds-btn-primary\">新建知识库</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border:none;border-radius:10px;background:var(--app-accent,#5856D6);color:#fff;font:600 14px/1.4 -apple-system,BlinkMacSystemFont,'PingFang SC','Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer;transition:background 150ms cubic-bezier(.4,0,.2,1),transform 150ms cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:var(--app-accent-hover,#3E3FB0)}.ds-btn-primary:active{background:var(--app-accent-pressed,#292E8A);transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--app-accent,#5856D6);outline-offset:2px}@media (prefers-color-scheme: dark){.ds-btn-primary{background:var(--app-accent-dark,#5B5BE8)}.ds-btn-primary:hover{background:var(--app-accent-hover-dark,#4642C2)}.ds-btn-primary:active{background:var(--app-accent-pressed-dark,#342D9C)}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "细填充灰底的次级按钮，hover 加深一档，无阴影。",
      "html": "<button class=\"ds-btn-secondary\">取消</button>",
