      "html": "<span style=\"display:inline-flex;gap:8px\"><span class=\"ds-tag\">PDF</span><span class=\"ds-tag ds-tag-selected\">公开</span></span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:22px;padding:0 10px;border-radius:9999px;background:var(--app-fill-subtle,rgba(120,120,128,0.08));color:var(--app-text-secondary,#6E6E73);font:500 12px/1 -apple-system,BlinkMacSystemFont,'PingFang SC','Segoe UI','Microsoft YaHei',sans-serif}.ds-tag-selected{background:rgba(88,86,214,0.10);color:var(--app-accent,#5856D6)}@media (prefers-color-scheme: dark){.ds-tag{background:rgba(120,120,128,0.24);color:rgba(235,235,245,0.60)}.ds-tag-selected{background:rgba(125,122,255,0.16);color:#878af5}}"
